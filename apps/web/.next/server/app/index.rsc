15:["$","footer",null,{"className":"ix-foot","children":[["$","p",null,{"children":"Informational only; not financial, legal, tax, or investment advice. $PENNY is not redeemable for the basket and does not represent ownership of Stock Tokens or underlying shares. Distributions are tokenised instruments providing economic exposure — not brokerage shares — and do not include voting rights or dividends. Rewards depend on trading volume and can pause; nothing here promises returns. Unavailable in restricted jurisdictions including the United States. Project is pre-launch and unaudited."}],["$","p",null,{"children":[["$","a",null,{"href":"https://github.com/sarv6969/penny-protocol","target":"_blank","rel":"noreferrer","children":"GitHub"}]," ","· ",["$","$L4",null,{"href":"/status","children":"Status"}]," · ©"," ",2026," Penny Protocol"]}]]}]
