# Penny Stocks — environment template. Copy to .env for local/test runs.
# NEVER commit a real .env, private key, seed phrase, or API secret.

# --- Chain / RPC (production must use authenticated archive-capable RPCs) ---
MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ARCHIVE_RPC_URL=
# Anvil-forked mainnet RPC for local/fork tests
LOCAL_RPC_URL=http://127.0.0.1:8545

# --- Indexer (Postgres) ---
INDEXER_DATABASE_URL=postgresql://penny:penny@localhost:5432/penny_indexer
INDEXER_START_BLOCK=0

# --- Keeper ---
# Production signing MUST use a KMS/secure relayer. Local anvil keys allowed only for local runs.
KEEPER_SIGNER_URL=
KEEPER_SIGNER_TYPE=anvil
KEEPER_CHECK_INTERVAL_MS=900000
KEEPER_MIN_SWEEP_USD=0
KEEPER_GAS_LIMIT_CAP=1000000
KEEPER_GAS_PRICE_CAP_GWEI=0

# --- Chainlink feed config (resolved dynamically onchain; do not hardcode feeds in code) ---
SEQUENCER_UPTIME_FEED=
ORACLE_STALENESS_SECONDS=3600
ORACLE_GRACE_PERIOD_SECONDS=0

# --- Compliance ---
MAX_ELIGIBLE_BALANCE_THRESHOLD=100000000000000000000000