{
  "name": "penny-stocks",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:contracts": "make contracts-test",
    "dev": "turbo run dev",
    "contracts:build": "turbo run build --filter=@penny/contracts",
    "contracts:test": "turbo run test --filter=@penny/contracts"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}