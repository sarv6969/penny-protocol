# $PONEY CANARY — Robinhood Chain mainnet test deployment
# Copy to .env.canary and fill the HUMAN INPUT values. Never commit .env.canary.

RPC_URL=https://rpc.mainnet.chain.robinhood.com

# ---- HUMAN INPUT (you supply; never invented, never shared with anyone) ----
PRIVATE_KEY=                 # fresh canary deployer key ONLY. not a treasury key.
KEEPER_ADDRESS=              # address that stages routes + publishes epochs
ATTESTATION_SIGNER=          # address whose signature gates reward eligibility

# ---- verified onchain (manifest, block 51175803) ----
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
V4_POSITION_MANAGER=0x58daec3116aae6d93017baaea7749052e8a04fa7
LIFI_ROUTER=0xB477751B76CF82d00a686A1232f5fCD772414Af3
FEED_ETH_USD=0x78F3556b67E17Df817D51Ef5a990cDaF09E8d3A9

# ---- canary basket: only constituents passing the oracle-deviation gate ----
CANARY_TOKENS=0xd917B029C761D264c6A312BBbcDA868658eF86a6
CANARY_FEEDS=0xA994d3684e8400A6c8078226925779FdeE682DD9

# ---- pool ----
POOL_FEE=3000
POOL_TICK_SPACING=60
POOL_SQRT_PRICE_X96=79228162514264337593543950336   # 1:1 start price

# ---- canary economics (small on purpose) ----
PONEY_SUPPLY=1000000000000000000000000000            # 1B * 1e18
MIN_SWEEP_WEI=2000000000000000                       # 0.002 WETH triggers a buyback
MAX_SLIPPAGE_BPS=300                                 # 3% onchain floor vs oracle
MAX_QUOTE_DEVIATION_BPS=500                          # 5% keeper-side quote gate
CHALLENGE_DELAY_SECONDS=300                          # 5 min root challenge window
KEEPER_INTERVAL_SECONDS=180                          # 3-minute cadence
STOCK_STALENESS_SECONDS=345600                       # 4 days (24/5 feeds span weekends)
ETH_STALENESS_SECONDS=93600                          # 26 hours
REBALANCE_TIMELOCK_SECONDS=604800                    # 7 days
